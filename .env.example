APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# NEVER set APP_DEBUG=true in production — it exposes SQL queries and stack traces over the network.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: SESSION_ENCRYPT=true and SESSION_SECURE_COOKIE=true (requires HTTPS).
SESSION_ENCRYPT=false
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime chat: use reverb + queue worker. Redis is optional for local dev — database queue works too.
BROADCAST_DRIVER=reverb
FILESYSTEM_DISK=local
# Say-it images (upload + AI): digitalocean, spaces, s3, public, or local (see config/filesystems.php).
# Local without Spaces: omit or use CONFESSIONS_STORAGE_DISK=public and run php artisan storage:link
# CONFESSIONS_STORAGE_DISK=digitalocean
# Local dev without Redis: use database. Production: redis (after brew install redis / apt install redis)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: used when Admin → Settings has no mail config, or as fallback.
# Set these in .env to use SMTP without saving in the dashboard.
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# For port 465 use: MAIL_PORT=465 and MAIL_ENCRYPTION=ssl

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Say-it AI images — optional fallback if not set in Admin → Settings → Say-it (Image generation).
# SAYIT_IMAGE_DRIVER=disabled|sdwebui|comfyui
SAYIT_IMAGE_DRIVER=disabled
# Show “Generate image” on Say-it when backend is configured (Admin can override with “Say-it composer: Generate image”).
# SAYIT_COMPOSER_AI_IMAGE_ENABLED=true
# SD Web UI (AUTOMATIC1111): base URL only, no trailing slash
SD_WEBUI_BASE_URL=
# URL Laravel uses when Web UI is on the same server (overrides SD_WEBUI_BASE_URL for API calls):
# SD_WEBUI_INTERNAL_BASE_URL=http://127.0.0.1:7860
# Optional: override automatic /sdapi proxy secret (default is derived from APP_KEY):
# SD_WEBUI_PROXY_SECRET=
# SD_WEBUI_VERIFY_SSL=false
# SAYIT_IMAGE_HTTP_TIMEOUT=180
# COMFYUI_BASE_URL=
# COMFYUI_INTERNAL_BASE_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=storage/app/comfyui/sayit_workflow_api.json
# COMFYUI_PROMPT_PLACEHOLDER=__SAYIT_PROMPT__
# COMFYUI_VERIFY_SSL=false
# COMFYUI_POLL_INTERVAL_MS=1000
# COMFYUI_POLL_MAX_ATTEMPTS=180
